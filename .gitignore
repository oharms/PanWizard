# Dependencies
node_modules/

# Environment & secrets
.env
.env.*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Test output scratch files
test-*.txt
test_output.txt

# Claude memory (user-specific)
.claude/memory/

# PAN self-installation artifacts (NEVER install PAN into source repo)
# These are created by the installer — block them from being committed.
# Dev tools (.claude/commands/*.md, .claude/agents/pan.md, pandev.md) are NOT affected.
.claude/commands/pan/
.claude/agents/pan-*.md
.claude/hooks/
.claude/pan-wizard-core/
.claude/pan-file-manifest.json
.claude/package.json
.claude/skills/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/*.lock

# Build artifacts
hooks/dist/
*.tgz

# Python bytecode (scripts/generate-skills-docs.py)
__pycache__/
*.pyc

# VSCode test downloads (E2E tests use system VSCode)
.vscode-test/

# Runtime install dirs (NEVER install PAN into source repo — use d:\pantesting)
.codex/
.gemini/
.opencode/

# .github/ — Copilot CLI install dir conflicts with GitHub Actions/Dependabot.
# We narrow-ignore just the installer artifacts so workflows + dependabot can
# live here too. Mirror of the `.claude/` pattern above.
.github/agents/pan-*.agent.md
.github/skills/pan-*/
.github/hooks/
.github/pan-wizard-core/
.github/pan-file-manifest.json
.github/package.json
.github/config.json
.github/CHANGELOG.md
.github/VERSION

# Test output
test-results/

# Temporary
tmp/

# PAN planning state (project-specific, not part of source distribution)
.planning/
.tmp/

# v3.7.0+ self-improvement loop: harvested experiment data IS part of the
# source repo's evidence trail (see ADR-0026). The .planning/ inside
# experiments/<slug>/ is harvested telemetry, not project working state —
# negate the ignore for those paths so the harvest is committable.
!experiments/
!experiments/**

# ...but secrets and build junk stay ignored, even under experiments/. Git
# applies the LAST matching pattern, so the two negations above undo EVERY
# blanket rule declared earlier in this file for any experiments/ path — each
# one that must survive has to be re-asserted here, after the negation.
# `**/` matches zero or more directories, so `experiments/**/x` covers both
# experiments/x and experiments/<slug>/nested/x.
# Any future blanket ignore that must survive the carve-out belongs here too.

# Secrets — never committable, carve-out or not (this repo is public)
experiments/**/.env
experiments/**/.env.*

# Dependencies, logs, OS/editor cruft
experiments/**/node_modules/
experiments/**/*.log
experiments/**/npm-debug.log*
experiments/**/.DS_Store
experiments/**/Thumbs.db
experiments/**/Desktop.ini
experiments/**/.vscode/
experiments/**/.idea/
experiments/**/*.sw[op]
experiments/**/*~

# Build artifacts and test downloads
experiments/**/__pycache__/
experiments/**/*.pyc
experiments/**/*.tgz
experiments/**/.vscode-test/

# Runtime install dirs (the never-install-into-source rule applies here too)
experiments/**/.codex/
experiments/**/.gemini/
experiments/**/.opencode/
experiments/**/.claude/pan-wizard-core/
experiments/**/.claude/pan-file-manifest.json


# Plugin build output
dist/
